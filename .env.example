AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Only needed to point extract.py/dedupe.py/timeline.py/major_events.py/
# illustrations/generate.py at the DEPLOYED Azure graph instead of the local
# Docker Neo4j above — Neo4j has no external Bolt ingress, so these scripts
# reach it through the app's authenticated /admin/cypher proxy instead. Leave
# both blank for normal local-Docker development.
#   ADMIN_API_URL: the deployed Container App's HTTPS URL (infra.yml's
#     "Print Neo4j connection info" step logs containerAppFqdn; prefix with
#     https://)
#   ADMIN_API_KEY: az keyvault secret show --vault-name <kv-name> \
#     --name admin-api-key --query value -o tsv
ADMIN_API_URL=
ADMIN_API_KEY=

# Only needed when regenerating illustrations (src/illustrations/generate.py).
# Points at a separate, temporary Azure OpenAI resource with a gpt-image-1
# deployment (gpt-image-1 isn't available in the main resource's region) —
# see README's "Illustrations" section. Never used by the deployed app.
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
